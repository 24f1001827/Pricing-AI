# Public URLs assigned during deployment
FRONTEND_URL=https://your-project.pages.dev
ALLOWED_ORIGINS=https://your-project.pages.dev
API_HOST=api.your-domain.example

# Generate a long, random value. Never commit the real value.
SECRET_KEY=replace-with-a-long-random-secret
GROQ_API_KEY=

# Docker Compose supplies these service URLs.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://pricing:replace-this-password@postgres:5432/pricing
MLFLOW_TRACKING_URI=http://mlflow:5000
LLM_PROVIDER=groq
SCHEDULER_TIMEZONE=Asia/Kolkata
RUN_SCHEDULER=false
COOKIE_SECURE=true
ALLOW_REGISTRATION=false
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
INITIAL_ADMIN_NAME=Administrator

# Optional alternative LLM providers. Leave blank unless selected through LLM_PROVIDER.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Required for the current sandboxed training and pricing workflow.
E2B_API_KEY=
